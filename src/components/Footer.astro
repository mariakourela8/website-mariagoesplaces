---
import Logo from './Logo.astro';
import { t, type Lang } from '../i18n/ui';
import { site } from '../site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
---
<footer class="footer">
  <div class="wrap footer-inner">
    <Logo href={`/${lang}/`} />
    <p class="note">{s.footerNote}</p>
    <nav class="links">
      <a class="label" href={`/${lang}/journal/`}>{s.journal}</a>
      <a class="label" href={`/${lang}/destinations/`}>{s.destinations}</a>
      <a class="label" href={`/${lang}/about/`}>{s.about}</a>
      <a class="label" href={site.instagram} target="_blank" rel="noopener">Instagram</a>
    </nav>
    <p class="copy">© {new Date().getFullYear()} {site.name}</p>
  </div>
</footer>
<style>
  .footer { background: var(--paper-2); padding: 64px 0 40px; margin-top: 40px; }
  .footer-inner { display: flex; flex-direction: column; align-items: center; gap: 18px; text-align: center; }
  .note { color: var(--ink-soft); font-family: var(--f-serif); font-style: italic; font-size: 20px; margin: 0; }
  .links { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 28px; }
  .links a { text-decoration: none; }
  .copy { font-size: 13px; color: var(--ink-soft); margin: 12px 0 0; }
</style>
