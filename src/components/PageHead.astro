---
interface Props { kicker?: string; title: string; intro?: string }
const { kicker, title, intro } = Astro.props;
---
<header class="page-head wrap">
  {kicker && <p class="label eyebrow">{kicker}</p>}
  <h1 class="display">{title}</h1>
  {intro && <p class="intro">{intro}</p>}
</header>
<style>
  .page-head { text-align: center; padding: clamp(48px, 8vw, 96px) var(--gutter) clamp(32px, 5vw, 56px); }
  .page-head .display { font-size: clamp(40px, 6.5vw, 72px); margin-top: 10px; }
  .intro { max-width: 560px; margin: 18px auto 0; color: var(--ink-soft); }
</style>
