---
import Logo from './Logo.astro';
import { t, langLabel, type Lang } from '../i18n/ui';
import { site } from '../site';

interface Props { lang: Lang; altHref: string; overlay?: boolean }
const { lang, altHref } = Astro.props;
const s = t(lang);
const other: Lang = lang === 'en' ? 'gr' : 'en';
const path = Astro.url.pathname;
const is = (p: string) => path.startsWith(`/${lang}/${p}`);
---
<header class="site-header">
  <div class="topbar">
    <div class="wrap topbar-inner">
      <div class="top-right">
        <a class="label" href={`/${lang}/journal/`}>{s.journal}</a>
        <a class="label" href={`/${lang}/about/`}>{s.about}</a>
        <a href={site.instagram} aria-label="Instagram" target="_blank" rel="noopener">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/></svg>
        </a>
        <span class="lang label">
          <span aria-current="true">{langLabel[lang]}</span>
          <span aria-hidden="true">/</span>
          <a href={altHref} hreflang={other === 'gr' ? 'el' : 'en'}>{langLabel[other]}</a>
        </span>
      </div>
    </div>
  </div>

  <div class="mainbar wrap">
    <nav class="nav nav-left" aria-label="Primary">
      <a class:list={['label', { on: is('journal') }]} href={`/${lang}/journal/`}>{s.journal}</a>
      <a class:list={['label', { on: is('food') }]} href={`/${lang}/food/`}>{s.food}</a>
    </nav>
    <Logo href={`/${lang}/`} />
    <nav class="nav nav-right" aria-label="Secondary">
      <a class:list={['label', { on: is('destinations') }]} href={`/${lang}/destinations/`}>{s.destinations}</a>
      <a class:list={['label', { on: is('about') }]} href={`/${lang}/about/`}>{s.aboutMe}</a>
    </nav>

    <button class="menu-btn label" aria-expanded="false" aria-controls="mobile-nav">{s.menu}</button>
  </div>

  <nav id="mobile-nav" class="mobile-nav" hidden>
    <a href={`/${lang}/journal/`}>{s.journal}</a>
    <a href={`/${lang}/destinations/`}>{s.destinations}</a>
    <a href={`/${lang}/food/`}>{s.food}</a>
    <a href={`/${lang}/about/`}>{s.aboutMe}</a>
    <a href={`/${lang}/search/`}>{s.search}</a>
    <a href={altHref}>{langLabel[other]}</a>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const nav = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    if (nav) nav.hidden = open;
  });
</script>

<style>
  .site-header { background: var(--white); position: relative; z-index: 10; }
  .topbar { background: var(--paper-2); font-size: 12px; }
  .topbar-inner { display: flex; justify-content: flex-end; align-items: center; height: 38px; }
  .top-right { display: flex; align-items: center; gap: 22px; }
  .top-right a { text-decoration: none; display: inline-flex; }
  .lang { display: inline-flex; gap: 6px; color: var(--ink-soft); }
  .lang [aria-current] { color: var(--ink); }

  .mainbar {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    padding-top: 22px; padding-bottom: 22px;
  }
  .nav { display: flex; gap: 32px; }
  .nav-right { justify-content: flex-end; }
  .nav a { text-decoration: none; padding: 4px 0; border-bottom: 1px solid transparent; }
  .nav a:hover, .nav a.on { border-color: var(--ink); }

  .menu-btn { display: none; background: none; border: 1px solid var(--ink); border-radius: var(--radius); padding: 6px 14px; cursor: pointer; justify-self: end; }
  .mobile-nav { border-top: 1px solid var(--line); padding: 8px var(--gutter) 20px; background: var(--white); }
  .mobile-nav a { display: block; padding: 12px 0; border-bottom: 1px solid var(--line); text-decoration: none; font-family: var(--f-serif); font-size: 24px; }

  @media (max-width: 860px) {
      .top-right .label { display: none; }
    .nav { display: none; }
    .mainbar { grid-template-columns: 1fr auto; padding-top: 14px; padding-bottom: 14px; }
    .menu-btn { display: inline-block; }
  }
  @media (min-width: 861px) { .mobile-nav { display: none; } }
</style>
