---
interface Props { href: string; light?: boolean }
const { href, light = false } = Astro.props;
---
<a href={href} class:list={['logo', { light }]} aria-label="Maria Goes Places, home">
  <span class="logo-maria">maria</span>
  <span class="logo-script">goes places</span>
</a>
<style>
  .logo {
    display: inline-flex; flex-direction: column; align-items: center;
    text-decoration: none; line-height: 1; color: var(--ink);
  }
  .logo.light { color: var(--white); }
  .logo-maria {
    font-family: var(--f-serif);
    font-size: 34px; font-weight: 300; letter-spacing: .04em;
  }
  .logo-script {
    font-family: var(--f-script);
    font-size: 34px; margin-top: -10px; margin-left: 38px;
  }
</style>
