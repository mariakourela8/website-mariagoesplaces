---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import StoryGrid from '../../../components/StoryGrid.astro';
import { t, langPaths, type Lang } from '../../../i18n/ui';
import { getStories } from '../../../lib/content';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = t(lang);
const stories = (await getStories(lang)).filter((x) => x.data.category === 'food' || x.data.tags.includes('food'));
---
<Base lang={lang} title={s.food}>
  <PageHead title={s.food} />
  <StoryGrid stories={stories} empty={s.nothingYet} />
</Base>
