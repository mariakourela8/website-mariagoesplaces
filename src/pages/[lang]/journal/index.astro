---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import StoryGrid from '../../../components/StoryGrid.astro';
import { t, langPaths, type Lang } from '../../../i18n/ui';
import { getStories } from '../../../lib/content';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = t(lang);
const stories = await getStories(lang);
---
<Base lang={lang} title={s.journal}>
  <PageHead kicker={s.heroKicker} title={s.journal} intro={s.tagline} />
  <StoryGrid stories={stories} empty={s.nothingYet} />
</Base>
