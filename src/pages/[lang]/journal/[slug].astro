---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Gallery from '../../../components/Gallery.astro';
import Highlights from '../../../components/Highlights.astro';
import StoryCard from '../../../components/StoryCard.astro';
import { t, formatDate, type Lang } from '../../../i18n/ui';
import { slugOf, langOf, getStories, countryUrl, countryNamer } from '../../../lib/content';

export async function getStaticPaths() {
  const all = await getCollection('stories', (s) => import.meta.env.DEV || !s.data.draft);
  return all.map((story) => ({
    params: { lang: langOf(story), slug: slugOf(story) },
    props: { story, hasTranslation: all.some((o) => o !== story && slugOf(o) === slugOf(story)) },
  }));
}

const { story, hasTranslation } = Astro.props;
const lang = Astro.params.lang as Lang;
const other: Lang = lang === 'en' ? 'gr' : 'en';
const s = t(lang);
const d = story.data;
const { Content } = await render(story);
const countryName = await countryNamer(lang);

const all = await getStories(lang);
const series = d.series
  ? all.filter((x) => x.data.series === d.series).sort((a, b) => (a.data.part ?? 0) - (b.data.part ?? 0))
  : [];
const related = (series.length > 1 ? series : all.filter((x) => x.data.country === d.country))
  .filter((x) => x.id !== story.id)
  .slice(0, 3);
const altHref = hasTranslation ? `/${other}/journal/${slugOf(story)}/` : `/${other}/journal/`;
---
<Base lang={lang} title={d.title} description={d.description} image={d.cover} altHref={altHref}>
  <article>
    <header class="a-head wrap">
      <p class="label eyebrow">
        <a href={countryUrl(lang, d.country)}>{[d.city, countryName(d.country)].filter(Boolean).join(', ')}</a>
        {d.part && <> · {s.part} {d.part}</>}
      </p>
      <h1 class="title-serif a-title">{d.title}</h1>
      {d.description && <p class="a-dek">{d.description}</p>}
      <p class="label a-date">{formatDate(d.date, lang)}</p>
    </header>

    <figure class="a-cover wrap">
      <img src={d.cover} alt={d.coverAlt} />
    </figure>

    <div class="prose narrow">
      <Content />
    </div>

    <div class="wrap">
      <Gallery images={d.gallery} title={s.gallery} />
    </div>

    {hasTranslation && (
      <p class="translation"><a class="label more" href={altHref}>{s.otherLang}</a></p>
    )}
  </article>

  <Highlights items={d.highlights} closeLabel={s.close} />

  {related.length > 0 && (
    <section class="section related">
      <div class="wrap">
        <h2 class="label section-head">{series.length > 1 ? s.inThisSeries : s.travelTo + ': ' + countryName(d.country)}</h2>
        <div class="grid3">{related.map((r) => <StoryCard story={r} />)}</div>
      </div>
    </section>
  )}
</Base>

<style>
  .a-head { text-align: center; padding-top: clamp(48px, 7vw, 90px); max-width: 900px; }
  .a-head .eyebrow a { text-decoration: none; }
  .a-title { font-size: clamp(40px, 6vw, 68px); margin: 16px 0 18px; }
  .a-dek { font-family: var(--f-serif); font-style: italic; font-size: 23px; color: var(--ink-soft); max-width: 640px; margin: 0 auto 18px; line-height: 1.4; }
  .a-date { color: var(--ink-soft); }
  .a-cover { margin: 40px auto 56px; max-width: 860px; }
  .a-cover img { width: 100%; aspect-ratio: 3 / 2; max-height: 70vh; object-fit: cover; }

  .prose { font-size: 18px; line-height: 1.85; }
  .prose :global(h2) { font-family: var(--f-serif); font-size: 36px; margin: 1.6em 0 .5em; }
  .prose :global(h3) { font-family: var(--f-sans); font-size: 13px; font-weight: 500; letter-spacing: .18em; text-transform: uppercase; margin: 2em 0 .6em; }
  .prose > :global(p:first-of-type::first-letter) { font-family: var(--f-display); float: left; font-size: 4.4em; line-height: .8; padding: 8px 10px 0 0; }
  /* Photos in the text: centred and capped so portrait shots don't fill the whole screen */
  .prose :global(p > img) { margin: 2em auto; width: auto; max-width: min(100%, 560px); max-height: min(560px, 70vh); }
  .prose :global(blockquote) { margin: 2em 0; padding: 0 0 0 24px; border-left: 1px solid var(--ink); font-family: var(--f-serif); font-style: italic; font-size: 26px; line-height: 1.4; }
  .prose :global(a:not(.pop-link)) { text-decoration-color: var(--accent); text-underline-offset: 3px; }
  .prose :global(hr) { border: 0; text-align: center; margin: 2.5em 0; }
  .prose :global(hr)::after { content: '✦ ✦ ✦'; letter-spacing: 1em; color: var(--accent); }

  .translation { text-align: center; margin: 0 0 40px; }
  .related { background: var(--white); }
  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  @media (max-width: 860px) { .grid3 { grid-template-columns: 1fr; } }
</style>
