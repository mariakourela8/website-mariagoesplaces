---
import Base from '../../layouts/Base.astro';
import StoryCard from '../../components/StoryCard.astro';
import TravelMap from '../../components/TravelMap.astro';
import { t, langPaths, type Lang } from '../../i18n/ui';
import { getStories, getPage, countryNamer, mapPoints, chronological, isTip } from '../../lib/content';
import { siteImage } from '../../lib/siteImages';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = t(lang);

const stories = await getStories(lang);
const countryName = await countryNamer(lang);
const featured = stories.find((x) => x.data.featured && x.data.cover) ?? stories.find((x) => x.data.cover);
const about = await getPage(lang, 'about');
const aboutIntro = about?.body?.split(/\n\s*\n/).slice(0, 2).join(' ').replace(/[#*_>\[\]]/g, '') ?? '';
// The three most recent stories, shown in the order they happened
const latest = chronological(stories.filter((x) => !isTip(x)).slice(0, 3));
const points = mapPoints(stories, countryName);
// Photos set in the CMS win; otherwise use public/images/site/ (hero falls back to the featured story's cover)
const heroImg = siteImage('hero') ?? featured?.data.cover;
const aboutImg1 = about?.data.image ?? siteImage('about-1');
const aboutImg2 = about?.data.image2 ?? siteImage('about-2');
---
<Base lang={lang} description={s.tagline} image={heroImg}>
  <!-- 1. Full-bleed hero -->
  <section class="hero">
    {heroImg && <img class="hero-img" src={heroImg} alt="" />}
    <div class="hero-shade"></div>
    <div class="wrap hero-inner">
      <p class="label hero-kicker">{s.heroKicker}</p>
      <h1 class="display hero-title">Maria<br />goes places</h1>
      <a class="btn btn--light label" href={`/${lang}/journal/`}>{s.seeMore}</a>
    </div>
  </section>

  <!-- 2. Latest stories -->
  <section class="section wrap">
    <div class="section-head">
      <h2 class="label">{s.latest}</h2>
    </div>
    {latest.length ? (
      <div class="grid3">{latest.map((st) => <StoryCard story={st} />)}</div>
    ) : (
      <p class="center">{s.nothingYet}</p>
    )}
    <p class="center"><a class="btn label" href={`/${lang}/journal/`}>{s.viewAll}</a></p>
  </section>

  <!-- 3. About me -->
  <section class="about-band">
    <div class="wrap about">
      <div class="about-imgs">
        {aboutImg1 && <div class="frame"><img src={aboutImg1} alt="" loading="lazy" /></div>}
        {aboutImg2 && <div class="frame"><img src={aboutImg2} alt="" loading="lazy" /></div>}
      </div>
      <div class="about-text">
        <h2 class="display">{s.aboutMe}</h2>
        {about?.data.subtitle && <p class="about-sub italic title-serif">{about.data.subtitle}</p>}
        <p>{aboutIntro}</p>
        <a class="btn label" href={`/${lang}/about/`}>{s.explore}</a>
      </div>
    </div>
  </section>

  <!-- 4. Map of all destinations -->
  {points.length > 0 && (
    <section class="section wrap">
      <h2 class="label section-head">{s.map}</h2>
      <TravelMap points={points} />
      <p class="center map-more"><a class="btn label" href={`/${lang}/destinations/`}>{s.allDestinations}</a></p>
    </section>
  )}
</Base>

<style>
  .hero { position: relative; min-height: clamp(480px, calc(100svh - var(--header-h)), 760px); display: flex; align-items: flex-end; overflow: hidden; background: var(--ink); }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center bottom; }
  .hero-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(30,26,22,.55), rgba(30,26,22,.1) 70%); }
  .hero-inner { position: relative; color: var(--white); width: 100%; padding-bottom: clamp(40px, 6vh, 64px); }
  .hero-kicker { opacity: .85; margin-bottom: 18px; }
  .hero-title { font-size: clamp(52px, 8vw, 100px); line-height: .95; margin-bottom: 32px; }

  .about-band { background: var(--white); padding: clamp(56px, 8vw, 100px) 0; }
  .about { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(28px, 5vw, 70px); align-items: center; }
  .about-imgs { display: grid; grid-template-columns: .8fr 1fr; gap: 14px; align-items: end; }
  .about-imgs .frame { aspect-ratio: 3 / 4; }
  .about-imgs .frame img { object-position: center 75%; }
  .about-imgs .frame:first-child { aspect-ratio: 3 / 3.4; }
  .about-text .display { font-size: clamp(40px, 5.5vw, 64px); margin-bottom: 18px; }
  .about-sub { font-size: 22px; margin: 8px 0 18px; }
  .about-text p { color: var(--ink-soft); }

  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin-bottom: 44px; }
  .center { text-align: center; }

  .map-more { margin: 36px 0 0; }

  @media (max-width: 860px) {
    .about { grid-template-columns: 1fr; }
    .grid3 { grid-template-columns: 1fr; }
    .about-text { order: -1; }
  }
</style>
