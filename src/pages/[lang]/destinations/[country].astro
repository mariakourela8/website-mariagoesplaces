---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import StoryGrid from '../../../components/StoryGrid.astro';
import TravelMap from '../../../components/TravelMap.astro';
import { t, slugify, langs, type Lang } from '../../../i18n/ui';
import { render } from 'astro:content';
import { getCountries, storyUrl, getDestination, countryNamer } from '../../../lib/content';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of langs) {
    for (const c of await getCountries(lang)) {
      paths.push({ params: { lang, country: slugify(c.country) }, props: { country: c.country, stories: c.stories } });
    }
  }
  return paths;
}

const { country, stories } = Astro.props;
const lang = Astro.params.lang as Lang;
const s = t(lang);
const name = (await countryNamer(lang))(country);
const intro = await getDestination(lang, country);
const Intro = intro ? (await render(intro)).Content : null;
const points = stories
  .filter((x) => typeof x.data.lat === 'number' && typeof x.data.lng === 'number')
  .map((x) => ({ lat: x.data.lat!, lng: x.data.lng!, title: x.data.title, href: storyUrl(x), place: x.data.city ?? name }));
---
<Base lang={lang} title={name}>
  <PageHead kicker={s.destinations} title={name} intro={stories.length ? s.stories(stories.length) : s.comingSoon} />
  {Intro && <div class="intro prose narrow"><Intro /></div>}
  <StoryGrid stories={stories} empty={s.nothingYet} />
  {points.length > 0 && <div class="wrap map-wrap"><TravelMap points={points} height="380px" /></div>}
  <p class="back"><a class="label more" href={`/${lang}/destinations/`}>{s.allDestinations}</a></p>
</Base>
<style>
  .intro { font-size: 18px; line-height: 1.85; margin-bottom: clamp(48px, 7vw, 80px); }
  .intro :global(h2) { font-family: var(--f-serif); font-size: 34px; margin: 1.5em 0 .5em; }
  .intro :global(h3) { font-family: var(--f-sans); font-size: 13px; font-weight: 500; letter-spacing: .18em; text-transform: uppercase; margin: 2em 0 .6em; }
  .intro :global(img) { margin: 2em auto; }
  .intro :global(blockquote) { margin: 2em 0; padding-left: 24px; border-left: 1px solid var(--ink); font-family: var(--f-serif); font-style: italic; font-size: 26px; line-height: 1.4; }
  .intro :global(a) { text-decoration-color: var(--accent); text-underline-offset: 3px; }
  .map-wrap { margin-bottom: 48px; }
  .back { text-align: center; margin-bottom: 40px; }
</style>
