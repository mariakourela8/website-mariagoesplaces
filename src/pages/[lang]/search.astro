---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { t, langPaths, type Lang } from '../../i18n/ui';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = t(lang);
---
<Base lang={lang} title={s.search}>
  <PageHead title={s.search} />
  <div class="narrow">
    <input id="q" type="search" placeholder={s.searchPlaceholder} autocomplete="off" aria-label={s.search} />
    <ul id="results" data-index={`/${lang}/search.json`} data-empty={s.noResults}></ul>
  </div>
</Base>

<script>
  type Item = { title: string; description: string; place: string; cover: string; href: string; text: string };
  const norm = (x: string) => x.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  const input = document.getElementById('q') as HTMLInputElement;
  const list = document.getElementById('results') as HTMLUListElement;
  let items: Item[] = [];
  fetch(list.dataset.index!).then((r) => r.json()).then((d: Item[]) => {
    items = d;
    const q = new URLSearchParams(location.search).get('q');
    if (q) { input.value = q; run(); }
  });
  function run() {
    const terms = norm(input.value).split(/\s+/).filter(Boolean);
    list.innerHTML = '';
    if (!terms.length) return;
    const hits = items.filter((it) => {
      const hay = norm([it.title, it.description, it.place, it.text].join(' '));
      return terms.every((t) => hay.includes(t));
    });
    if (!hits.length) {
      const li = document.createElement('li');
      li.className = 'none';
      li.textContent = list.dataset.empty!;
      list.append(li);
      return;
    }
    for (const h of hits) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = h.href;
      const img = document.createElement('img'); img.src = h.cover; img.alt = '';
      const div = document.createElement('div');
      const p = document.createElement('p'); p.className = 'label'; p.textContent = h.place;
      const h3 = document.createElement('h3'); h3.textContent = h.title;
      div.append(p, h3); a.append(img, div); li.append(a); list.append(li);
    }
  }
  input.addEventListener('input', run);
  input.focus();
</script>

<style>
  #q {
    width: 100%; font: inherit; font-family: var(--f-serif); font-size: 28px;
    padding: 12px 0; border: 0; border-bottom: 1px solid var(--ink); background: transparent; outline: none; color: var(--ink);
  }
  #results { list-style: none; padding: 0; margin: 32px 0 100px; }
  #results :global(li) { border-bottom: 1px solid var(--line); }
  #results :global(a) { display: grid; grid-template-columns: 110px 1fr; gap: 20px; align-items: center; padding: 16px 0; text-decoration: none; }
  #results :global(img) { width: 110px; aspect-ratio: 4 / 3; object-fit: cover; }
  #results :global(h3) { font-family: var(--f-serif); font-size: 26px; }
  #results :global(.label) { margin: 0 0 4px; color: var(--ink-soft); }
  #results :global(.none) { padding: 24px 0; font-family: var(--f-serif); font-style: italic; font-size: 22px; color: var(--ink-soft); border: 0; }
</style>
